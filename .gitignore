# build output
# dist/ lleva la clave del formulario ya inyectada en el HTML (ver Contact.astro):
# nunca debe subirse al repo, solo al VPS con `make deploy`.
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# playwright mcp artifacts
# Snapshots en texto plano con datos de contacto (telefono, email) repetidos:
# ruido y pie de bala si algun dia se ignora mal. No se commitean.
.playwright-mcp/

# environment variables
# PORTFOLIO_ACCESS_KEY (Web3Forms) vive aqui. No es un secreto real: viaja al
# HTML publico por diseno, pero el archivo no se sube al repo.
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# secrets
acckey.txt
salida.txt
