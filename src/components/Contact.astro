---
import { site } from '../data/site';

interface Props {
  email: string;
  linkedin?: string;
  github?: string;
  phone?: string;
  whatsapp?: string;
}

const { email, linkedin, github, phone, whatsapp } = Astro.props;
const { title, subtitle, formTitle, formName, formEmail, formMessage, formSubmit, formSuccess, formSuccessTitle, captchaError } = site.contact;
---

<section id="contacto" class="py-20 min-h-dvh bg-white dark:bg-linear-to-br dark:from-slate-950 dark:to-slate-700">
  <div class="js-reveal max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-navy dark:text-slate-100 mb-4">{title}</h2>
      <div class="w-20 h-1 bg-blue-bright mx-auto rounded-full mb-4" />
      <p class="text-lg text-gray-600 dark:text-slate-300 max-w-2xl mx-auto">
        {subtitle}
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="grid md:grid-cols-3 gap-8">
        <a
          href={`mailto:${email}`}
          class="group flex flex-col items-center p-8 rounded-xl border border-gray-200 dark:border-slate-700 hover:border-blue-bright hover:shadow-lg dark:hover:shadow-slate-900/50 transition-all duration-300"
        >
          <div class="w-14 h-14 bg-blue-50 dark:bg-blue-900/30 rounded-full flex items-center justify-center mb-4 group-hover:bg-blue-bright transition-colors">
            <svg class="w-7 h-7 text-blue-bright group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-navy dark:text-slate-100 mb-1">Email</h3>
          <p class="text-gray-500 dark:text-slate-400 text-sm">{email}</p>
        </a>

        {linkedin && (
          <a
            href={linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col items-center p-8 rounded-xl border border-gray-200 dark:border-slate-700 hover:border-blue-bright hover:shadow-lg dark:hover:shadow-slate-900/50 transition-all duration-300"
          >
            <div class="w-14 h-14 bg-blue-50 dark:bg-blue-900/30 rounded-full flex items-center justify-center mb-4 group-hover:bg-blue-bright transition-colors">
              <svg class="w-7 h-7 text-blue-bright group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-navy dark:text-slate-100 mb-1">LinkedIn</h3>
            <p class="text-gray-500 dark:text-slate-400 text-sm">Conectar</p>
          </a>
        )}

        {github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col items-center p-8 rounded-xl border border-gray-200 dark:border-slate-700 hover:border-blue-bright hover:shadow-lg dark:hover:shadow-slate-900/50 transition-all duration-300"
          >
            <div class="w-14 h-14 bg-blue-50 dark:bg-blue-900/30 rounded-full flex items-center justify-center mb-4 group-hover:bg-blue-bright transition-colors">
              <svg class="w-7 h-7 text-blue-bright group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-navy dark:text-slate-100 mb-1">GitHub</h3>
            <p class="text-gray-500 dark:text-slate-400 text-sm">Ver proyectos</p>
          </a>
        )}

        {phone && (
          <a
            href={`tel:${phone}`}
            class="group flex flex-col items-center p-8 rounded-xl border border-gray-200 dark:border-slate-700 hover:border-blue-bright hover:shadow-lg dark:hover:shadow-slate-900/50 transition-all duration-300"
          >
            <div class="w-14 h-14 bg-blue-50 dark:bg-blue-900/30 rounded-full flex items-center justify-center mb-4 group-hover:bg-blue-bright transition-colors">
              <svg class="w-7 h-7 text-blue-bright group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-navy dark:text-slate-100 mb-1">Teléfono</h3>
            <p class="text-gray-500 dark:text-slate-400 text-sm">Realizar llamada</p>
          </a>
        )}

        {whatsapp && (
          <a
            href={`https://wa.me/${whatsapp}`}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col items-center p-8 rounded-xl border border-gray-200 dark:border-slate-700 hover:border-blue-bright hover:shadow-lg dark:hover:shadow-slate-900/50 transition-all duration-300"
          >
            <div class="w-14 h-14 bg-blue-50 dark:bg-blue-900/30 rounded-full flex items-center justify-center mb-4 group-hover:bg-blue-bright transition-colors">
              <svg class="w-7 h-7 text-blue-bright group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-navy dark:text-slate-100 mb-1">WhatsApp</h3>
            <p class="text-gray-500 dark:text-slate-400 text-sm">Escribir mensaje</p>
          </a>
        )}
      </div>

      <div class="mt-12 bg-gray-50 dark:bg-slate-800 rounded-2xl p-8 md:p-12">
        <h3 id="form-title" class="text-2xl font-semibold text-navy dark:text-slate-100 mb-6 text-center">{formTitle}</h3>
        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="max-w-lg mx-auto space-y-4"
          id="contact-form"
          data-captcha-error={captchaError}
          data-success-title={formSuccessTitle}
        >
          <input type="hidden" name="access_key" value={import.meta.env.PORTFOLIO_ACCESS_KEY} />
          <input type="hidden" name="subject" value="Nuevo mensaje desde tu portfolio" />
          <input type="hidden" name="from_name" value="Portfolio Contact Form" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" />
          <div class="grid md:grid-cols-2 gap-4">
            <input
              type="text"
              name="name"
              placeholder={formName}
              class="w-full px-4 py-3 rounded-lg border border-gray-200 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100 placeholder-gray-400 dark:placeholder-slate-400 focus:border-blue-bright focus:ring-2 focus:ring-blue-100 dark:focus:ring-blue-900 outline-none transition-all"
              required
            />
            <input
              type="email"
              name="email"
              placeholder={formEmail}
              class="w-full px-4 py-3 rounded-lg border border-gray-200 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100 placeholder-gray-400 dark:placeholder-slate-400 focus:border-blue-bright focus:ring-2 focus:ring-blue-100 dark:focus:ring-blue-900 outline-none transition-all"
              required
            />
          </div>
          <textarea
            name="body"
            rows={4}
            placeholder={formMessage}
            class="w-full px-4 py-3 rounded-lg border border-gray-200 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100 placeholder-gray-400 dark:placeholder-slate-400 focus:border-blue-bright focus:ring-2 focus:ring-blue-100 dark:focus:ring-blue-900 outline-none transition-all resize-none"
            required
          ></textarea>
          <div class="flex justify-center">
            <div class="h-captcha" data-captcha="true"></div>
          </div>
          <button
            type="submit"
            class="w-full bg-blue-bright text-white py-3.5 rounded-lg font-semibold hover:bg-navy dark:hover:bg-navy transition-colors shadow-lg shadow-blue-200 dark:shadow-blue-900/30 hover:shadow-blue-300"
          >
            {formSubmit}
          </button>
          <div id="form-success" class="hidden text-center text-green-600 dark:text-green-400 font-medium py-4">
            {formSuccess}
          </div>
        </form>
        <script>
          const form = document.getElementById('contact-form') as HTMLFormElement;
          const successMsg = document.getElementById('form-success');
          const captchaAlert = form?.dataset.captchaError || 'Por favor, completa el captcha.';
          const successTitleText = form?.dataset.successTitle || 'Mensaje enviado';

          form?.addEventListener('submit', (e) => {
            e.preventDefault();
            const data = new FormData(form);
            const response = data.get('h-captcha-response');
            if (!response) {
              alert(captchaAlert);
              return;
            }
            fetch('https://api.web3forms.com/submit', {
              method: 'POST',
              body: data,
            })
              .then((res) => res.json())
              .then((json) => {
                if (json.success) {
                  form.style.display = 'none';
                  const title = document.getElementById('form-title');
                  if (title) title.textContent = successTitleText;
                  successMsg?.classList.remove('hidden');
                }
              });
          });
        </script>
      </div>
    </div>
  </div>
</section>
