---
interface Props {
  email: string;
  linkedin?: string;
  github?: string;
  phone?: string;
}

const { email, linkedin, github, phone } = Astro.props;
---

<section id="contacto" class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-navy mb-4">Contacto</h2>
      <div class="w-20 h-1 bg-blue-bright mx-auto rounded-full mb-4" />
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        ¿Tienes un proyecto en mente o buscas un desarrollador para tu equipo?
        ¡Estoy abierto a nuevas oportunidades!
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Email -->
        <a
          href={`mailto:${email}`}
          class="group flex flex-col items-center p-8 rounded-xl border border-gray-200 hover:border-blue-bright hover:shadow-lg transition-all duration-300"
        >
          <div class="w-14 h-14 bg-blue-50 rounded-full flex items-center justify-center mb-4 group-hover:bg-blue-bright transition-colors">
            <svg class="w-7 h-7 text-blue-bright group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-navy mb-1">Email</h3>
          <p class="text-gray-500 text-sm">{email}</p>
        </a>

        <!-- LinkedIn -->
        {linkedin && (
          <a
            href={linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col items-center p-8 rounded-xl border border-gray-200 hover:border-blue-bright hover:shadow-lg transition-all duration-300"
          >
            <div class="w-14 h-14 bg-blue-50 rounded-full flex items-center justify-center mb-4 group-hover:bg-blue-bright transition-colors">
              <svg class="w-7 h-7 text-blue-bright group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-navy mb-1">LinkedIn</h3>
            <p class="text-gray-500 text-sm">Conectar</p>
          </a>
        )}

        <!-- GitHub -->
        {github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col items-center p-8 rounded-xl border border-gray-200 hover:border-blue-bright hover:shadow-lg transition-all duration-300"
          >
            <div class="w-14 h-14 bg-blue-50 rounded-full flex items-center justify-center mb-4 group-hover:bg-blue-bright transition-colors">
              <svg class="w-7 h-7 text-blue-bright group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-navy mb-1">GitHub</h3>
            <p class="text-gray-500 text-sm">Ver proyectos</p>
          </a>
        )}
      </div>

      <!-- Contact form card -->
      <div class="mt-12 bg-gray-50 rounded-2xl p-8 md:p-12">
        <h3 class="text-2xl font-semibold text-navy mb-6 text-center">Envíame un mensaje</h3>
        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="max-w-lg mx-auto space-y-4"
          id="contact-form"
        >
          <input type="hidden" name="access_key" value={import.meta.env.PORTFOLIO_ACCESS_KEY} />
          <input type="hidden" name="subject" value="Nuevo mensaje desde tu portfolio" />
          <input type="hidden" name="from_name" value="Portfolio Contact Form" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" />
          <div class="grid md:grid-cols-2 gap-4">
            <input
              type="text"
              name="name"
              placeholder="Tu nombre"
              class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-blue-bright focus:ring-2 focus:ring-blue-100 outline-none transition-all"
              required
            />
            <input
              type="email"
              name="email"
              placeholder="Tu email"
              class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-blue-bright focus:ring-2 focus:ring-blue-100 outline-none transition-all"
              required
            />
          </div>
          <textarea
            name="body"
            rows={4}
            placeholder="Cuéntame sobre tu proyecto..."
            class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-blue-bright focus:ring-2 focus:ring-blue-100 outline-none transition-all resize-none"
            required
          ></textarea>
          <button
            type="submit"
            class="w-full bg-blue-bright text-white py-3.5 rounded-lg font-semibold hover:bg-navy transition-colors shadow-lg shadow-blue-200 hover:shadow-blue-300"
          >
            Enviar mensaje
          </button>
          <div id="form-success" class="hidden text-center text-green-600 font-medium py-4">
            Mensaje enviado correctamente. ¡Gracias!
          </div>
        </form>
        <script>
          const form = document.getElementById('contact-form') as HTMLFormElement;
          const successMsg = document.getElementById('form-success');
          form?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const data = new FormData(form);
            const res = await fetch('https://api.web3forms.com/submit', {
              method: 'POST',
              body: data,
            });
            const json = await res.json();
            if (json.success) {
              form.style.display = 'none';
              successMsg?.classList.remove('hidden');
            }
          });
        </script>
      </div>
    </div>
  </div>
</section>
