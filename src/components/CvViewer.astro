---
import { site } from '../data/site';

const pdfUrl = site.hero.cvUrl;
---

<div
  id="cv-modal"
  class="fixed inset-0 z-60 flex items-center justify-center invisible opacity-0 transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cv-modal-title"
  data-pdf-url={pdfUrl}
>
  <div class="absolute inset-0 bg-slate-900/70 backdrop-blur-sm" data-cv-close></div>

  <div class="relative flex h-full w-full flex-col overflow-hidden bg-white dark:bg-slate-900 md:h-[90vh] md:w-[90vw] md:max-w-5xl md:rounded-xl md:shadow-2xl">
    <header class="flex items-center justify-between gap-4 border-b border-gray-200 px-4 py-3 dark:border-slate-800">
      <h2 id="cv-modal-title" class="text-base font-bold text-navy dark:text-slate-100">
        Currículum Vitae
      </h2>
      <div class="flex items-center gap-2">
        <a
          href={pdfUrl}
          download
          class="inline-flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-1.5 text-sm font-medium text-gray-600 transition-colors hover:border-blue-bright hover:text-blue-bright dark:border-slate-700 dark:text-slate-300 dark:hover:border-blue-bright dark:hover:text-blue-bright"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <path d="M7 10l5 5 5-5" />
            <path d="M12 15V3" />
          </svg>
          <span class="hidden sm:inline">Descargar PDF</span>
          <span class="sr-only sm:hidden">Descargar PDF</span>
        </a>
        <button
          type="button"
          data-cv-close
          class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-gray-500 transition-colors hover:bg-gray-100 hover:text-navy dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100"
          aria-label="Cerrar visor"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </button>
      </div>
    </header>

    <div class="flex flex-wrap items-center justify-center gap-2 border-b border-gray-200 px-4 py-2 dark:border-slate-800">
      <button
        type="button"
        data-cv-prev
        class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-gray-500 transition-colors hover:bg-gray-100 hover:text-navy disabled:opacity-30 disabled:hover:bg-transparent dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100"
        aria-label="Página anterior"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          <path d="m15 18-6-6 6-6" />
        </svg>
      </button>
      <p class="min-w-24 text-center text-sm font-medium text-gray-600 dark:text-slate-300">
        <span data-cv-page>1</span> / <span data-cv-pages>–</span>
      </p>
      <button
        type="button"
        data-cv-next
        class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-gray-500 transition-colors hover:bg-gray-100 hover:text-navy disabled:opacity-30 disabled:hover:bg-transparent dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100"
        aria-label="Página siguiente"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          <path d="m9 18 6-6-6-6" />
        </svg>
      </button>
      <span class="mx-1 hidden h-4 w-px bg-gray-200 sm:block dark:bg-slate-700" aria-hidden="true"></span>
      <button
        type="button"
        data-cv-zoom-out
        class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-gray-500 transition-colors hover:bg-gray-100 hover:text-navy disabled:opacity-30 disabled:hover:bg-transparent dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100"
        aria-label="Reducir zoom"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h14" />
        </svg>
      </button>
      <p class="min-w-12 text-center text-sm font-medium text-gray-600 dark:text-slate-300" data-cv-zoom>100%</p>
      <button
        type="button"
        data-cv-zoom-in
        class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-gray-500 transition-colors hover:bg-gray-100 hover:text-navy disabled:opacity-30 disabled:hover:bg-transparent dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100"
        aria-label="Aumentar zoom"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h14" />
          <path d="M12 5v14" />
        </svg>
      </button>
    </div>

    <div data-cv-stage class="relative flex-1 overflow-auto bg-gray-100 p-4 dark:bg-slate-800">
      <p
        data-cv-status
        class="absolute inset-0 flex items-center justify-center px-6 text-center text-sm font-medium text-gray-500 dark:text-slate-400"
        role="status"
        aria-live="polite"
      >
        Cargando documento…
      </p>
      <canvas
        data-cv-canvas
        class="mx-auto block rounded-sm bg-white shadow-lg"
        aria-label="Página del currículum"
      ></canvas>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('cv-modal');

  if (modal) {
    const pdfUrl = modal.dataset.pdfUrl ?? '';
    const stage = modal.querySelector<HTMLElement>('[data-cv-stage]')!;
    const canvas = modal.querySelector<HTMLCanvasElement>('[data-cv-canvas]')!;
    const statusEl = modal.querySelector<HTMLElement>('[data-cv-status]')!;
    const pageEl = modal.querySelector<HTMLElement>('[data-cv-page]')!;
    const pagesEl = modal.querySelector<HTMLElement>('[data-cv-pages]')!;
    const zoomEl = modal.querySelector<HTMLElement>('[data-cv-zoom]')!;
    const prevBtn = modal.querySelector<HTMLButtonElement>('[data-cv-prev]')!;
    const nextBtn = modal.querySelector<HTMLButtonElement>('[data-cv-next]')!;
    const zoomInBtn = modal.querySelector<HTMLButtonElement>('[data-cv-zoom-in]')!;
    const zoomOutBtn = modal.querySelector<HTMLButtonElement>('[data-cv-zoom-out]')!;
    const closeBtn = modal.querySelector<HTMLButtonElement>('button[data-cv-close]')!;
    const triggers = document.querySelectorAll('[data-cv-open]');

    const ZOOM_STEPS = [0.5, 0.75, 1, 1.25, 1.5, 2, 2.5, 3];

    // pdfjs-dist no exporta tipos para su subpath .min.mjs (ver src/env.d.ts)
    let pdfjsLib: any = null;
    let doc: any = null;
    let pageNum = 1;
    let zoomIndex = ZOOM_STEPS.indexOf(1);
    let renderTask: any = null;
    let renderToken = 0;
    let lastFocused: HTMLElement | null = null;
    let isLoading = false;

    const setStatus = (message: string) => {
      statusEl.textContent = message;
      statusEl.classList.toggle('hidden', !message);
    };

    const syncControls = () => {
      const total = doc ? doc.numPages : 0;
      pageEl.textContent = String(pageNum);
      pagesEl.textContent = total ? String(total) : '–';
      zoomEl.textContent = `${Math.round(ZOOM_STEPS[zoomIndex] * 100)}%`;
      prevBtn.disabled = !doc || pageNum <= 1;
      nextBtn.disabled = !doc || pageNum >= total;
      zoomInBtn.disabled = zoomIndex >= ZOOM_STEPS.length - 1;
      zoomOutBtn.disabled = zoomIndex <= 0;
    };

    const loadPdfJs = async () => {
      if (pdfjsLib) return pdfjsLib;
      const [lib, worker] = await Promise.all([
        import('pdfjs-dist/build/pdf.min.mjs'),
        import('pdfjs-dist/build/pdf.worker.min.mjs?url'),
      ]);
      lib.GlobalWorkerOptions.workerSrc = worker.default;
      pdfjsLib = lib;
      return lib;
    };

    const render = async (token: number) => {
      if (!doc || !canvas || !stage) return;

      if (renderTask) {
        renderTask.cancel();
        renderTask = null;
      }

      const page = await doc.getPage(pageNum);
      const base = page.getViewport({ scale: 1 });
      const available = Math.max(stage.clientWidth - 32, 120);
      const scale = (available / base.width) * ZOOM_STEPS[zoomIndex];
      const viewport = page.getViewport({ scale });
      const outputScale = window.devicePixelRatio || 1;

      canvas.width = Math.floor(viewport.width * outputScale);
      canvas.height = Math.floor(viewport.height * outputScale);
      canvas.style.width = `${Math.floor(viewport.width)}px`;
      canvas.style.height = `${Math.floor(viewport.height)}px`;

      renderTask = page.render({
        canvas,
        viewport,
        transform: outputScale !== 1 ? [outputScale, 0, 0, outputScale, 0, 0] : null,
      });

      await renderTask.promise;

      if (token === renderToken) setStatus('');
    };

    const refresh = async (token: number) => {
      try {
        await render(token);
      } catch (error) {
        if (error instanceof Error && error.name === 'RenderingCancelledException') return;
        setStatus('No se pudo mostrar el documento. Abre el PDF en una pestaña nueva.');
      }
    };

    const initialize = async () => {
      if (doc || isLoading) return;
      isLoading = true;
      setStatus('Cargando documento…');
      syncControls();
      try {
        const lib = await loadPdfJs();
        const token = renderToken;
        doc = await lib.getDocument({ url: pdfUrl }).promise;
        pageNum = 1;
        syncControls();
        await refresh(token);
      } catch (error) {
        setStatus('No se pudo cargar el documento. Abre el PDF en una pestaña nueva.');
      } finally {
        isLoading = false;
        syncControls();
      }
    };

    const renderCurrent = async () => {
      const token = ++renderToken;
      syncControls();
      await refresh(token);
    };

    const open = () => {
      lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      modal.classList.remove('invisible', 'opacity-0');
      modal.classList.add('visible', 'opacity-100');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
      initialize();
    };

    const close = () => {
      modal.classList.add('invisible', 'opacity-0');
      modal.classList.remove('visible', 'opacity-100');
      document.body.style.overflow = '';
      if (renderTask) {
        renderTask.cancel();
        renderTask = null;
      }
      renderToken += 1;
      if (lastFocused instanceof HTMLElement) lastFocused.focus();
    };

    const goToPage = (target: number) => {
      if (!doc) return;
      const next = Math.min(Math.max(target, 1), doc.numPages);
      if (next === pageNum) return;
      pageNum = next;
      stage.scrollTo({ top: 0, left: 0 });
      renderCurrent();
    };

    const setZoom = (index: number) => {
      const next = Math.min(Math.max(index, 0), ZOOM_STEPS.length - 1);
      if (next === zoomIndex) return;
      zoomIndex = next;
      syncControls();
      renderCurrent();
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        open();
      });
    });

    modal.querySelectorAll('[data-cv-close]').forEach((el) => {
      el.addEventListener('click', close);
    });

    prevBtn?.addEventListener('click', () => goToPage(pageNum - 1));
    nextBtn?.addEventListener('click', () => goToPage(pageNum + 1));
    zoomInBtn?.addEventListener('click', () => setZoom(zoomIndex + 1));
    zoomOutBtn?.addEventListener('click', () => setZoom(zoomIndex - 1));

    document.addEventListener('keydown', (event) => {
      const isOpen = !modal.classList.contains('invisible');

      if (event.key === 'Escape' && isOpen) {
        close();
        return;
      }

      if (!isOpen) return;

      if (event.key === 'ArrowLeft') goToPage(pageNum - 1);
      if (event.key === 'ArrowRight') goToPage(pageNum + 1);
      if (event.key === '+' || event.key === '=') setZoom(zoomIndex + 1);
      if (event.key === '-') setZoom(zoomIndex - 1);

      if (event.key === 'Tab') {
        const focusables = modal.querySelectorAll<HTMLElement>('button:not([disabled]), a[href]');
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    let resizeTimeout: ReturnType<typeof setTimeout> | undefined;
    new ResizeObserver(() => {
      if (modal.classList.contains('invisible') || !doc) return;
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(renderCurrent, 200);
    }).observe(stage);

    syncControls();
  }
</script>
