---
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const { available, role, description, ctaText, contactText, techLabel, technologies } = t.hero;
---

<section class="min-h-screen flex items-center justify-center bg-white dark:bg-slate-900 pt-16">
  <div class="text-center max-w-4xl mx-auto px-6">
    <div class="inline-flex items-center gap-2 bg-blue-50 dark:bg-blue-900/30 text-blue-bright dark:text-blue-400 px-4 py-2 rounded-full text-sm font-medium mb-8">
      <span class="w-2 h-2 bg-blue-bright dark:bg-blue-400 rounded-full animate-pulse" />
      {available}
    </div>
    <h1 class="text-5xl md:text-7xl font-bold text-navy dark:text-slate-100 mb-4 leading-tight">
      Lucas Sánchez
    </h1>
    <p class="text-2xl md:text-3xl text-blue-bright font-semibold mb-6">
      {role}
    </p>
    <p class="text-lg text-gray-600 dark:text-slate-300 mb-10 max-w-2xl mx-auto leading-relaxed">
      {description}
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={t.lang === 'es' ? '#proyectos' : '#projects'}
        class="bg-blue-bright text-white px-8 py-3.5 rounded-lg font-semibold hover:bg-navy dark:hover:bg-navy transition-colors shadow-lg shadow-blue-200 dark:shadow-blue-900/30 hover:shadow-blue-300"
      >
        {ctaText}
      </a>
      <a
        href={t.lang === 'es' ? '#contacto' : '#contact'}
        class="border-2 border-blue-bright text-blue-bright px-8 py-3.5 rounded-lg font-semibold hover:bg-blue-bright hover:text-white transition-colors"
      >
        {contactText}
      </a>
      <a
        href="/Lucas_Sanchez_Acosta_CV.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="border-2 border-gray-300 dark:border-slate-600 text-gray-600 dark:text-slate-300 px-8 py-3.5 rounded-lg font-semibold hover:bg-navy dark:hover:bg-navy hover:text-white dark:hover:text-white hover:border-navy dark:hover:border-navy transition-colors"
      >
        ↓ CV
      </a>
    </div>
    <div class="mt-16 flex flex-wrap items-center justify-center gap-4 md:gap-8 text-gray-400 dark:text-slate-500">
      <span class="text-sm font-medium uppercase tracking-wider">{techLabel}</span>
      <div class="flex flex-wrap items-center justify-center gap-4 md:gap-6 text-gray-500 dark:text-slate-400">
        {technologies.map((tech) => (
          <span class="text-lg font-semibold hover:text-blue-bright dark:hover:text-blue-400 transition-colors">{tech}</span>
        ))}
      </div>
    </div>
  </div>
</section>
