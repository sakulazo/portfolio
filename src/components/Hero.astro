---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import foto from '../assets/yo_bien_cortado.png';

const { available, role, description, ctaText, contactText, techLabel } = site.hero;
const roleParts = role.split(' & ');
---

<section id="inicio" class="min-h-dvh flex items-center justify-center bg-white dark:bg-linear-to-br dark:from-slate-950 dark:to-slate-700 pt-32 sm:pt-16">
  <div class="js-reveal max-w-6xl mx-auto px-6 grid lg:grid-cols-2 gap-x-12 items-center">
    <div class="order-2 lg:order-1 text-center">
    <div class="inline-flex items-center gap-2 bg-blue-50 dark:bg-blue-900/30 text-blue-bright dark:text-blue-400 px-4 py-2 rounded-full text-sm font-medium mb-8">
      <span class="w-2 h-2 bg-blue-bright dark:bg-blue-400 rounded-full animate-pulse" />
      {available}
    </div>
    <h1 class="text-5xl md:text-7xl font-bold text-navy dark:text-slate-100 mb-4 leading-tight">
      Lucas Sánchez
    </h1>
    <p class="text-2xl md:text-3xl text-blue-bright font-semibold mb-6 text-center">
      {roleParts.length === 2 ? (
        <>
          {roleParts[0]} &<br class="md:hidden" /> {roleParts[1]}
        </>
      ) : (
        role
      )}
    </p>
    <p class="text-lg text-gray-600 dark:text-slate-300 mb-10 max-w-2xl mx-auto text-left leading-relaxed">
      {description}
    </p>
    </div>

    <div class="order-3 lg:col-span-2">
    <div class="flex flex-col md:flex-row items-center justify-center gap-4">
      <a
        href="/261014_Lucas_Sanchez_Acosta_CV.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full md:w-56 inline-flex items-center justify-center gap-2 bg-blue-bright text-white px-8 py-3.5 rounded-lg font-semibold hover:bg-navy dark:hover:bg-white dark:hover:text-black dark:border-2 dark:border-transparent dark:hover:border-blue-bright transition-colors shadow-lg shadow-blue-200 dark:shadow-blue-900/30 hover:shadow-blue-300"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <path d="M7 10l5 5 5-5" />
          <path d="M12 15V3" />
        </svg>
        Currículum Vitae
      </a>
      <a
        href="#proyectos"
        class="w-full md:w-56 inline-flex items-center justify-center gap-2 bg-blue-bright text-white px-8 py-3.5 rounded-lg font-semibold hover:bg-navy dark:hover:bg-white dark:hover:text-black dark:border-2 dark:border-transparent dark:hover:border-blue-bright transition-colors shadow-lg shadow-blue-200 dark:shadow-blue-900/30 hover:shadow-blue-300"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7" rx="1" />
          <rect x="14" y="3" width="7" height="7" rx="1" />
          <rect x="14" y="14" width="7" height="7" rx="1" />
          <rect x="3" y="14" width="7" height="7" rx="1" />
        </svg>
        {ctaText}
      </a>
      <a
        href="#contacto"
        class="w-full md:w-56 inline-flex items-center justify-center gap-2 bg-blue-bright text-white px-8 py-3.5 rounded-lg font-semibold hover:bg-navy dark:hover:bg-white dark:hover:text-black dark:border-2 dark:border-transparent dark:hover:border-blue-bright transition-colors shadow-lg shadow-blue-200 dark:shadow-blue-900/30 hover:shadow-blue-300"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </svg>
        {contactText}
      </a>
    </div>
    <div class="mt-16 flex flex-col items-center justify-center gap-4 text-gray-400 dark:text-slate-500">
      <span class="text-sm font-medium uppercase tracking-wider whitespace-nowrap">{techLabel}</span>
