---
import { site } from '../data/site';

const { title, bio, badges, skillsTitle } = site.about;
const categories = [...new Set(site.skills.map((s) => s.category))];
---

<section id="sobre-mi" class="py-20 min-h-dvh bg-gray-50 dark:bg-slate-800">
  <div class="js-reveal max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-navy dark:text-slate-100 mb-4">{title}</h2>
      <div class="w-20 h-1 bg-blue-bright mx-auto rounded-full" />
    </div>
    <div class="grid md:grid-cols-2 gap-12 items-start">
      <div>
        <p class="text-lg text-gray-700 dark:text-slate-300 leading-relaxed mb-6 whitespace-pre-line">{bio}</p>
        <div class="flex flex-wrap gap-4">
          {badges.map((badge) => (
            <div class="flex items-center gap-3 bg-white dark:bg-slate-700 px-5 py-4 rounded-xl shadow-sm dark:shadow-slate-900/50">
              {badge.icon === 'graduation' && (
                <svg class="w-8 h-8 shrink-0 text-blue-bright dark:text-blue-400" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" />
                  <path d="M22 10v6" />
                  <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" />
                </svg>
              )}
              {badge.icon === 'gear' && (
                <svg class="w-8 h-8 shrink-0 text-blue-bright dark:text-blue-400" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
              )}
              {badge.icon === 'brain' && (
                <svg class="w-8 h-8 shrink-0 text-blue-bright dark:text-blue-400" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 4.5a2.5 2.5 0 0 0-4.96-.46 2.5 2.5 0 0 0-1.98 3 2.5 2.5 0 0 0-1.32 4.24 3 3 0 0 0 .34 5.58 2.5 2.5 0 0 0 2.96 3.08A2.5 2.5 0 0 0 12 19.5a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 12 4.5" />
                  <path d="M12 4.5V19.5" />
                  <path d="M10.5 4.5c-.73.48-1.6 1.13-2.16 2.19a4.8 4.8 0 0 0-.47 2.06" />
                  <path d="M13.5 4.5c.73.48 1.6 1.13 2.16 2.19.38.66.47 1.36.47 2.06" />
                  <path d="M8.5 19.5c.8-.5 1.7-1.16 2.29-2.24a5 5 0 0 0 .43-2.01" />
                  <path d="M15.5 19.5c-.8-.5-1.7-1.16-2.29-2.24a5 5 0 0 1-.43-2.01" />
                </svg>
              )}
              <span class="text-base font-medium text-gray-700 dark:text-slate-200">{badge.text}</span>
            </div>
          ))}
        </div>
      </div>
      <div>
        <h3 class="text-2xl font-semibold text-navy dark:text-slate-100 mb-8">{skillsTitle}</h3>
        {categories.map((category) => (
          <details class="group mb-4 bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-lg overflow-hidden">
            <summary class="flex items-center justify-between gap-3 px-5 py-4 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden transition-colors hover:bg-gray-50 dark:hover:bg-slate-700">
              <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-slate-400">{category}</h4>
              <svg class="w-4 h-4 shrink-0 text-gray-400 dark:text-slate-500 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="px-5 pb-5 space-y-3 border-t border-gray-100 dark:border-slate-700 overflow-hidden">
              {site.skills
                .filter((s) => s.category === category)
                .map((skill) => (
                  <div class="pt-4">
                    <span class="block font-medium text-gray-700 dark:text-slate-200">{skill.name}</span>
                  </div>
                ))}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const DURATION = 260;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLDetailsElement>('#sobre-mi details').forEach((card) => {
    const content = card.querySelector<HTMLElement>(':scope > div');
    if (!content) return;

    const styles = getComputedStyle(content);
    // scrollHeight incluye el padding pero no el borde; con box-sizing: border-box
    // hay que sumarlo para que la animación acabe en la altura real.
    const border =
      parseFloat(styles.borderTopWidth) + parseFloat(styles.borderBottomWidth);
    const targetHeight = () => content.scrollHeight + border;

    let isOpen = card.open;

    const animate = (open: boolean) => {
      const from = card.open ? content.getBoundingClientRect().height : 0;
      content.getAnimations().forEach((animation) => animation.cancel());

      if (open) {
        card.open = true;
        content.animate(
          [{ height: `${from}px`, opacity: 0 }, { height: `${targetHeight()}px`, opacity: 1 }],
          { duration: DURATION, easing: 'ease-out' },
        );
      } else {
        const animation = content.animate(
          [{ height: `${from}px`, opacity: 1 }, { height: '0px', opacity: 0 }],
          { duration: DURATION, easing: 'ease-in', fill: 'forwards' },
        );
        animation.finished
          .then(() => {
            card.open = false;
            animation.cancel();
          })
          .catch(() => {});
      }
    };

    const toggle = () => {
      isOpen = !isOpen;
      if (reducedMotion) {
        card.open = isOpen;
        return;
      }
      animate(isOpen);
    };

    // Sincroniza el estado si el navegador abre/cierra la card por su cuenta
    // (p. ej. al buscar texto en la página con Ctrl+F).
    card.addEventListener('toggle', () => {
      if (!content.getAnimations().length) isOpen = card.open;
    });

    // El summary lo gestiona el navegador: interceptamos para poder animar.
    card.querySelector('summary')?.addEventListener('click', (event) => {
      event.preventDefault();
      toggle();
    });
  });
</script>
