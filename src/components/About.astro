---
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const { title, bio, badges, skillsTitle } = t.about;
const categories = [...new Set(t.skills.map((s) => s.category))];
---

<section id={t.lang === 'es' ? 'sobre-mi' : 'about'} class="py-20 bg-gray-50 dark:bg-slate-800">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-navy dark:text-slate-100 mb-4">{title}</h2>
      <div class="w-20 h-1 bg-blue-bright mx-auto rounded-full" />
    </div>
    <div class="grid md:grid-cols-2 gap-12 items-start">
      <div>
        <p class="text-lg text-gray-700 dark:text-slate-300 leading-relaxed mb-6 whitespace-pre-line">{bio}</p>
        <div class="flex flex-wrap gap-3">
          {badges.map((badge) => (
            <div class="flex items-center gap-2 bg-white dark:bg-slate-700 px-4 py-2 rounded-lg shadow-sm dark:shadow-slate-900/50">
              <span class="text-2xl">{badge.icon}</span>
              <span class="text-sm font-medium text-gray-700 dark:text-slate-200">{badge.text}</span>
            </div>
          ))}
        </div>
      </div>
      <div>
        <h3 class="text-2xl font-semibold text-navy dark:text-slate-100 mb-8">{skillsTitle}</h3>
        {categories.map((category) => (
          <div class="mb-6">
            <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-slate-400 mb-3">{category}</h4>
            <div class="space-y-3">
              {t.skills
                .filter((s) => s.category === category)
                .map((skill) => (
                  <div key={skill.name}>
                    <div class="flex justify-between mb-1">
                      <span class="font-medium text-gray-700 dark:text-slate-200">{skill.name}</span>
                      <span class="text-xs text-gray-400 dark:text-slate-500">{skill.level}/10</span>
                    </div>
                    <div class="h-2 bg-gray-200 dark:bg-slate-600 rounded-full overflow-hidden">
                      <div
                        class="h-full bg-blue-bright rounded-full transition-all duration-500"
                        style={`width: ${(skill.level / 10) * 100}%`}
                      />
                    </div>
                  </div>
                ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
