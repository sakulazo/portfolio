---
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const currentYear = new Date().getFullYear();
const { description, navTitle, contactTitle, navigation, copyright } = t.footer;
---

<footer class="bg-navy dark:bg-slate-950 text-white py-12">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <div>
        <h3 class="text-xl font-bold mb-3">&lt;Lucas Sánchez /&gt;</h3>
        <p class="text-gray-300 text-sm leading-relaxed">
          {description}
        </p>
      </div>
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-400 mb-4">{navTitle}</h4>
        <ul class="space-y-2">
          {navigation.map((link) => (
            <li><a href={link.href} class="text-gray-300 hover:text-white transition-colors text-sm">{link.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-400 mb-4">{contactTitle}</h4>
        <ul class="space-y-2">
          <li><a href="mailto:lucassanchezacosta@gmail.com" class="text-gray-300 hover:text-white transition-colors text-sm">lucassanchezacosta@gmail.com</a></li>
          <li><a href="https://github.com/sakulazo" target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-white transition-colors text-sm">GitHub</a></li>
          <li><a href="https://www.linkedin.com/in/lucas-s%C3%A1nchez-dev" target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-white transition-colors text-sm">LinkedIn</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-gray-700 pt-8 text-center">
      <p class="text-gray-400 text-sm">
        &copy; {currentYear} {copyright}
      </p>
    </div>
  </div>
</footer>
