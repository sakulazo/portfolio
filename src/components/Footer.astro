---
import { site } from '../data/site';

const currentYear = new Date().getFullYear();
const { copyright, legalTitle, legalText } = site.footer;
---

<footer class="bg-navy dark:bg-slate-950 text-white py-5">
  <div class="max-w-6xl mx-auto px-6">
    <input type="checkbox" id="legal-toggle" class="peer sr-only" />
    <div class="flex flex-row flex-nowrap items-center gap-4 text-sm text-gray-300">
      <div class="md:flex-1 md:text-left">
        <a href="#inicio" class="text-lg font-bold text-white whitespace-nowrap">&lt;Lucas Sánchez /&gt;</a>
      </div>
<div class="flex w-full items-center justify-end gap-6 md:mx-auto md:flex-1">
  <label
    for="legal-toggle"
    class="inline-flex items-center gap-2 cursor-pointer select-none tracking-wider font-semibold text-gray-300 hover:text-white transition-colors"
  >
    <svg
      class="w-4 h-4"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z" />
      <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z" />
      <path d="M7 21h10" />
      <path d="M12 3v18" />
      <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2" />
    </svg>
    {legalTitle}
    <svg
      id="legal-chevron"
      class="w-3.5 h-3.5 transition-transform duration-300"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6" />
    </svg>
  </label>
</div>

    </div>
    <div id="legal-text" class="hidden peer-checked:block border-t border-gray-700 mt-4 pt-4">
      <p class="text-gray-300 text-sm leading-relaxed">{legalText}</p>
    </div>
  </div>
</footer>

<script>
  const toggle = document.getElementById('legal-toggle');
  const chevron = document.getElementById('legal-chevron');
  const legalText = document.getElementById('legal-text');

  toggle?.addEventListener('change', () => {
    const open = toggle.checked;
    if (chevron) {
      chevron.style.transform = open ? 'rotate(180deg)' : 'rotate(0deg)';
    }
    if (open && legalText) {
      legalText.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  });
</script>