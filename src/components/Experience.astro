---
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const { title, jobs } = t.experience;
---

<section id={t.lang === 'es' ? 'experiencia' : 'experience'} class="py-20 bg-gray-50 dark:bg-slate-800">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-navy dark:text-slate-100 mb-4">{title}</h2>
      <div class="w-20 h-1 bg-blue-bright mx-auto rounded-full" />
    </div>
    <div class="relative">
      <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-gray-200 dark:bg-slate-600 transform md:-translate-x-px" />

      <div class="space-y-12">
        {jobs.map((job, index) => (
          <div class={`relative flex flex-col md:flex-row ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
            <div class="absolute left-4 md:left-1/2 w-4 h-4 bg-blue-bright rounded-full border-4 border-white dark:border-slate-800 shadow transform -translate-x-1/2 mt-6 z-10" />

            <div class={`ml-10 md:ml-0 md:w-1/2 ${index % 2 === 0 ? 'md:pr-12' : 'md:pl-12'}`}>
              <div class="bg-white dark:bg-slate-700 p-6 rounded-xl shadow-sm dark:shadow-slate-900/50 border border-gray-100 dark:border-slate-600 hover:shadow-md transition-shadow">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-2">
                  <h3 class="text-xl font-semibold text-navy dark:text-slate-100">{job.position}</h3>
                  <span class="text-sm text-gray-400 dark:text-slate-400 font-medium mt-1 md:mt-0">{job.period}</span>
                </div>
                <p class="text-blue-bright font-medium mb-3">{job.company}</p>
                <p class="text-gray-600 dark:text-slate-300 mb-3 leading-relaxed">{job.description}</p>
                {job.achievements && job.achievements.length > 0 && (
                  <ul class="space-y-2">
                    {job.achievements.map((achievement) => (
                      <li class="flex items-start gap-2 text-gray-600 dark:text-slate-300 text-sm">
                        <svg class="w-5 h-5 text-blue-bright shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>{achievement}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
