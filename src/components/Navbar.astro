---
import { site } from '../data/site';

const { links } = site.nav;
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-white/90 dark:bg-slate-900/90 backdrop-blur-sm border-b border-gray-100 dark:border-slate-800">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="text-xl font-bold text-navy dark:text-slate-100">
      &lt;Lucas Sánchez /&gt;
    </a>
    <ul class="hidden md:flex items-center gap-8">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-gray-600 dark:text-slate-300 hover:text-blue-bright dark:hover:text-blue-bright transition-colors font-medium"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="hidden md:flex items-center gap-3">
      <label class="theme-switch" title="Cambiar tema">
        <input type="checkbox" class="theme-switch-input" aria-label="Activar modo claro" />
        <svg class="theme-switch-icon theme-switch-sun" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2" />
          <path d="M12 20v2" />
          <path d="m4.93 4.93 1.41 1.41" />
          <path d="m17.66 17.66 1.41 1.41" />
          <path d="M2 12h2" />
          <path d="M20 12h2" />
          <path d="m6.34 17.66-1.41 1.41" />
          <path d="m19.07 4.93-1.41 1.41" />
        </svg>
        <svg class="theme-switch-icon theme-switch-moon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
        <span class="theme-switch-thumb" aria-hidden="true"></span>
      </label>
    </div>
    <button
      id="menu-toggle"
      class="md:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5"
      aria-label="Abrir menú"
    >
      <span id="bar-1" class="block w-6 h-0.5 bg-navy dark:bg-slate-100 transition-all duration-300" />
      <span id="bar-2" class="block w-6 h-0.5 bg-navy dark:bg-slate-100 transition-all duration-300" />
      <span id="bar-3" class="block w-6 h-0.5 bg-navy dark:bg-slate-100 transition-all duration-300" />
    </button>
  </div>
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-white dark:bg-slate-900 border-t border-gray-100 dark:border-slate-800"
  >
    <ul class="flex flex-col items-center gap-4 py-6">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="mobile-nav-link text-gray-600 dark:text-slate-300 hover:text-blue-bright dark:hover:text-blue-bright transition-colors font-medium text-lg"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="flex items-center justify-center gap-4">
        <label class="theme-switch" title="Cambiar tema">
          <input type="checkbox" class="theme-switch-input" aria-label="Activar modo claro" />
          <svg class="theme-switch-icon theme-switch-sun" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2" />
            <path d="M12 20v2" />
            <path d="m4.93 4.93 1.41 1.41" />
            <path d="m17.66 17.66 1.41 1.41" />
            <path d="M2 12h2" />
            <path d="M20 12h2" />
            <path d="m6.34 17.66-1.41 1.41" />
            <path d="m19.07 4.93-1.41 1.41" />
          </svg>
          <svg class="theme-switch-icon theme-switch-moon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
          </svg>
          <span class="theme-switch-thumb" aria-hidden="true"></span>
        </label>
      </li>
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const bar1 = document.getElementById('bar-1');
  const bar2 = document.getElementById('bar-2');
  const bar3 = document.getElementById('bar-3');
  const links = document.querySelectorAll('.mobile-nav-link');

  let open = false;

  function update() {
    if (open) {
      menu?.classList.remove('hidden');
      bar1?.classList.add('rotate-45', 'translate-y-2');
      bar2?.classList.add('opacity-0');
      bar3?.classList.add('-rotate-45', '-translate-y-2');
      toggle?.setAttribute('aria-label', 'Cerrar menú');
    } else {
      menu?.classList.add('hidden');
      bar1?.classList.remove('rotate-45', 'translate-y-2');
      bar2?.classList.remove('opacity-0');
      bar3?.classList.remove('-rotate-45', '-translate-y-2');
      toggle?.setAttribute('aria-label', 'Abrir menú');
    }
  }

  toggle?.addEventListener('click', () => {
    open = !open;
    update();
  });

  links.forEach((link) => {
    link.addEventListener('click', () => {
      open = false;
      update();
    });
  });

  function applyTheme(isLight) {
    document.documentElement.classList.toggle('dark', !isLight);
    localStorage.setItem('theme', isLight ? 'light' : 'dark');
    const switches = document.querySelectorAll('.theme-switch-input');
    switches.forEach((input) => {
      input.checked = isLight;
      input.setAttribute('aria-label', isLight ? 'Activar modo oscuro' : 'Activar modo claro');
    });
  }

  document.querySelectorAll('.theme-switch-input').forEach((input) => {
    input.checked = !document.documentElement.classList.contains('dark');
    input.setAttribute('aria-label', input.checked ? 'Activar modo oscuro' : 'Activar modo claro');
    input.addEventListener('change', () => applyTheme(input.checked));
  });
</script>

<style>
  .theme-switch {
    position: relative;
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    cursor: pointer;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  :global(.dark) .theme-switch {
    background: #1e293b;
    border-color: #1e293b;
  }

  .theme-switch:hover {
    border-color: rgba(6, 182, 212, 0.4);
  }

  .theme-switch:focus-within {
    border-color: rgba(6, 182, 212, 0.5);
    box-shadow: 0 0 0 2px rgba(6, 182, 212, 0.25);
  }

  .theme-switch-input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }

  .theme-switch-thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background-image: linear-gradient(135deg, #06b6d4, #3b82f6);
    transform: translateX(0);
    transition: transform 0.3s ease;
    z-index: 0;
  }

  .theme-switch-icon {
    position: relative;
    z-index: 1;
    width: 26px;
    height: 26px;
    padding: 5px;
    box-sizing: border-box;
    color: #64748b;
    transition: color 0.3s ease;
  }

  .theme-switch-sun {
    color: #ffffff;
  }

  :global(.dark) .theme-switch-thumb {
    transform: translateX(100%);
  }

  :global(.dark) .theme-switch-moon {
    color: #ffffff;
  }

  :global(.dark) .theme-switch-sun {
    color: #64748b;
  }
</style>
