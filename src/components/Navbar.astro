---
interface NavLink {
  href: string;
  label: string;
}

const navLinks: NavLink[] = [
  { href: "#sobre-mi", label: "Sobre Mí" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#experiencia", label: "Experiencia" },
  { href: "#contacto", label: "Contacto" },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-sm border-b border-gray-100">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="#" class="text-xl font-bold text-navy">
      &lt;Lucas Sánchez /&gt;
    </a>
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-gray-600 hover:text-blue-bright transition-colors font-medium"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <a
      href="#contacto"
      class="hidden md:block bg-blue-bright text-white px-5 py-2 rounded-lg text-sm font-semibold hover:bg-navy transition-colors"
    >
      Contáctame
    </a>
    <button
      id="menu-toggle"
      class="md:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5"
      aria-label="Abrir menú"
    >
      <span id="bar-1" class="block w-6 h-0.5 bg-navy transition-all duration-300" />
      <span id="bar-2" class="block w-6 h-0.5 bg-navy transition-all duration-300" />
      <span id="bar-3" class="block w-6 h-0.5 bg-navy transition-all duration-300" />
    </button>
  </div>
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-white border-t border-gray-100"
  >
    <ul class="flex flex-col items-center gap-4 py-6">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="mobile-nav-link text-gray-600 hover:text-blue-bright transition-colors font-medium text-lg"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="#contacto"
          class="mobile-nav-link bg-blue-bright text-white px-6 py-2.5 rounded-lg font-semibold hover:bg-navy transition-colors"
        >
          Contáctame
        </a>
      </li>
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const bar1 = document.getElementById('bar-1');
  const bar2 = document.getElementById('bar-2');
  const bar3 = document.getElementById('bar-3');
  const links = document.querySelectorAll('.mobile-nav-link');

  let open = false;

  function update() {
    if (open) {
      menu?.classList.remove('hidden');
      bar1?.classList.add('rotate-45', 'translate-y-2');
      bar2?.classList.add('opacity-0');
      bar3?.classList.add('-rotate-45', '-translate-y-2');
      toggle?.setAttribute('aria-label', 'Cerrar menú');
    } else {
      menu?.classList.add('hidden');
      bar1?.classList.remove('rotate-45', 'translate-y-2');
      bar2?.classList.remove('opacity-0');
      bar3?.classList.remove('-rotate-45', '-translate-y-2');
      toggle?.setAttribute('aria-label', 'Abrir menú');
    }
  }

  toggle?.addEventListener('click', () => {
    open = !open;
    update();
  });

  links.forEach((link) => {
    link.addEventListener('click', () => {
      open = false;
      update();
    });
  });
</script>
