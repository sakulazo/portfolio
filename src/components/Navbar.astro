---
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
  currentLang: 'es' | 'en';
}

const { t, currentLang } = Astro.props;
const { links, contactBtn } = t.nav;
const otherLang = currentLang === 'es' ? 'en' : 'es';
const otherLangUrl = currentLang === 'es' ? '/en/' : '/';
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-white/90 dark:bg-slate-900/90 backdrop-blur-sm border-b border-gray-100 dark:border-slate-800">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href={otherLang === 'en' ? '/en/' : '/'} class="text-xl font-bold text-navy dark:text-slate-100">
      &lt;Lucas Sánchez /&gt;
    </a>
    <ul class="hidden md:flex items-center gap-8">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-gray-600 dark:text-slate-300 hover:text-blue-bright dark:hover:text-blue-bright transition-colors font-medium"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="hidden md:flex items-center gap-3">
      <button
        id="theme-toggle"
        class="w-9 h-9 flex items-center justify-center rounded-lg text-gray-500 dark:text-slate-400 hover:bg-gray-100 dark:hover:bg-slate-800 transition-colors"
        aria-label="Toggle theme"
      >
        <svg class="w-5 h-5 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </button>
      <a
        href={otherLangUrl}
        class="w-9 h-9 flex items-center justify-center rounded-lg text-xs font-bold text-gray-500 dark:text-slate-400 hover:bg-gray-100 dark:hover:bg-slate-800 transition-colors uppercase tracking-wider"
        aria-label="Switch language"
      >
        {otherLang}
      </a>
      <a
        href={currentLang === 'es' ? '#contacto' : '#contact'}
        class="bg-blue-bright text-white px-5 py-2 rounded-lg text-sm font-semibold hover:bg-navy dark:hover:bg-navy transition-colors"
      >
        {contactBtn}
      </a>
    </div>
    <button
      id="menu-toggle"
      class="md:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5"
      aria-label="Abrir menú"
    >
      <span id="bar-1" class="block w-6 h-0.5 bg-navy dark:bg-slate-100 transition-all duration-300" />
      <span id="bar-2" class="block w-6 h-0.5 bg-navy dark:bg-slate-100 transition-all duration-300" />
      <span id="bar-3" class="block w-6 h-0.5 bg-navy dark:bg-slate-100 transition-all duration-300" />
    </button>
  </div>
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-white dark:bg-slate-900 border-t border-gray-100 dark:border-slate-800"
  >
    <ul class="flex flex-col items-center gap-4 py-6">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="mobile-nav-link text-gray-600 dark:text-slate-300 hover:text-blue-bright dark:hover:text-blue-bright transition-colors font-medium text-lg"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="flex items-center gap-4">
        <button
          id="theme-toggle-mobile"
          class="w-9 h-9 flex items-center justify-center rounded-lg text-gray-500 dark:text-slate-400 hover:bg-gray-100 dark:hover:bg-slate-800 transition-colors"
          aria-label="Toggle theme"
        >
          <svg class="w-5 h-5 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </button>
        <a
          href={otherLangUrl}
          class="w-9 h-9 flex items-center justify-center rounded-lg text-xs font-bold text-gray-500 dark:text-slate-400 hover:bg-gray-100 dark:hover:bg-slate-800 transition-colors uppercase tracking-wider"
          aria-label="Switch language"
        >
          {otherLang}
        </a>
      </li>
      <li>
        <a
          href={currentLang === 'es' ? '#contacto' : '#contact'}
          class="mobile-nav-link bg-blue-bright text-white px-6 py-2.5 rounded-lg font-semibold hover:bg-navy dark:hover:bg-navy transition-colors"
        >
          {contactBtn}
        </a>
      </li>
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const bar1 = document.getElementById('bar-1');
  const bar2 = document.getElementById('bar-2');
  const bar3 = document.getElementById('bar-3');
  const links = document.querySelectorAll('.mobile-nav-link');

  let open = false;

  function update() {
    if (open) {
      menu?.classList.remove('hidden');
      bar1?.classList.add('rotate-45', 'translate-y-2');
      bar2?.classList.add('opacity-0');
      bar3?.classList.add('-rotate-45', '-translate-y-2');
      toggle?.setAttribute('aria-label', 'Cerrar menú');
    } else {
      menu?.classList.add('hidden');
      bar1?.classList.remove('rotate-45', 'translate-y-2');
      bar2?.classList.remove('opacity-0');
      bar3?.classList.remove('-rotate-45', '-translate-y-2');
      toggle?.setAttribute('aria-label', 'Abrir menú');
    }
  }

  toggle?.addEventListener('click', () => {
    open = !open;
    update();
  });

  links.forEach((link) => {
    link.addEventListener('click', () => {
      open = false;
      update();
    });
  });

  function toggleTheme() {
    const html = document.documentElement;
    const isDark = html.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  }

  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);
</script>
