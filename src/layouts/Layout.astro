---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  lang?: string;
}

const {
  title = "Lucas Sánchez | Desarrollador Web · SDD & Automatización con IA",
  description = "Técnico Superior en Desarrollo Web especializado en SDD, automatización con IA y desarrollo de aplicaciones web con PHP, Laravel y JavaScript.",
  ogImage = "https://portfolio.sakulazo.com/og-image.png",
  lang = "es",
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Lucas Sánchez" />

    <script>
      (function () {
        var theme = localStorage.getItem('theme');
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script src="https://web3forms.com/client/script.js" async defer></script>

    <!-- Structured Data - Person Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Lucas Sánchez",
      "jobTitle": lang === 'en' ? 'Web Developer · SDD & AI Automation' : 'Desarrollador Web · SDD & Automatización con IA',
      "url": "https://portfolio.sakulazo.com",
      "sameAs": [
        "https://github.com/sakulazo",
        "https://www.linkedin.com/in/lucas-s%C3%A1nchez-dev"
      ],
      "knowsAbout": [
        "Desarrollo Web",
        "PHP",
        "Laravel",
        "JavaScript",
        "Docker",
        "Linux",
        "SDD",
        "Automatización con IA"
      ]
    })}>
    </script>

    <title>{title}</title>
  </head>
  <body class="bg-white dark:bg-slate-900 text-gray-900 dark:text-slate-100 antialiased">
    <slot />
  </body>
</html>
